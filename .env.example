# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_IDS=[]

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Google Sheets Configuration
GOOGLE_CREDENTIALS_FILE=config/credentials/google_service_account.json
FUND_METRICS_SHEET_ID=your_google_sheet_id_here
# Use open-ended ranges (e.g., A1:Z instead of A1:Z100) to automatically fetch all rows
# Empty rows will be automatically removed
FUND_METRICS_RANGE=Fund Performance!A1:Z
PORTFOLIO_SHEET_ID=your_google_sheet_id_here
# Example: Portfolio!R6:AR fetches from column R to AR, starting at row 6, all rows with data
PORTFOLIO_RANGE=Portfolio!R6:AR

# Application Settings
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_USER=20
LOG_LEVEL=INFO

# For Railway deployment: uncomment and use this instead of GOOGLE_CREDENTIALS_FILE
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
